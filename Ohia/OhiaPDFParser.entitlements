<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Parses untrusted PDF attachments. Deliberately no network, no app
	     group, no user-selected files: the LiteParse helper inherits this
	     sandbox and can reach nothing but the PDF it is handed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
